[Unit]
Description=Shuzhiren PostgreSQL archive backup
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/shuzhiren/backup.env

[Service]
Type=oneshot
User=shuzhiren-backup
Group=shuzhiren-backup
EnvironmentFile=/etc/shuzhiren/backup.env
WorkingDirectory=/srv/shuzhiren
ExecStart=/usr/bin/env bash /srv/shuzhiren/scripts/backup-postgres.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/shuzhiren/backups/postgres
