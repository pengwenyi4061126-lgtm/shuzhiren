[Unit]
Description=Shuzhiren Runtime Gateway command journal snapshot
After=network-online.target
ConditionPathExists=/etc/shuzhiren/backup.env

[Service]
Type=oneshot
User=shuzhiren-backup
Group=shuzhiren-backup
EnvironmentFile=/etc/shuzhiren/backup.env
WorkingDirectory=/srv/shuzhiren
ExecStart=/usr/bin/env bash /srv/shuzhiren/scripts/backup-runtime-gateway-state.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/srv/shuzhiren/runtime-gateway-state
ReadWritePaths=/srv/shuzhiren/backups/runtime-gateway
