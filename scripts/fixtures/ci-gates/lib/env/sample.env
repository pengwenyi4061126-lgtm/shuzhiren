# Fixture for parseEnvFile: every supported form.
EMPTY=

PLAIN=value
TRIMMED=   padded value
INLINE=value # trailing comment
HASH_IN_VALUE=https://example.com/#fragment
JSON=[{"id":"a","url":"https://x.example/#y"}]
SINGLE='literal $HOME \n'
DOUBLE="line\nnext \"quoted\" \$5"
QUOTED_COMMENT="value" # comment after a quoted value
DUP=first
DUP=second
   INDENTED=yes
