# Docker Compose interpolation for the production control-plane image. Keep the
# referenced control.env outside Git and bind the browser port to loopback unless
# a separately reviewed reverse proxy or private network requires another IP.
CONTROL_PLANE_ENV_FILE=/srv/shuzhiren/control.env
CONSOLE_HOST_BIND=127.0.0.1
CONSOLE_PORT=3000
# Production Compose only pulls reviewed images by manifest digest. The migration
# target is intentionally separate from the web runtime image and is used only
# by the one-shot `migrate` profile.
CONTROL_PLANE_IMAGE=replace-with-registry.example.com/shuzhiren/control-plane@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
CONTROL_PLANE_MIGRATOR_IMAGE=replace-with-registry.example.com/shuzhiren/control-plane-migrator@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
