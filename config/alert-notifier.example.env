# Private, durable runtime-alert delivery. The target endpoint should be an
# approved enterprise bot/webhook, never a browser-facing service.
DATABASE_URL=postgresql://shuzhiren:replace-me@postgres:5432/shuzhiren
# Connection acquisition and individual query deadline for durable alert delivery.
DATABASE_QUERY_TIMEOUT_MS=5000
ALERT_NOTIFIER_PORT=8083
ALERT_NOTIFIER_POLL_MS=5000
ALERT_NOTIFIER_LEASE_SECONDS=60
ALERT_NOTIFIER_MAX_ATTEMPTS=6
ALERT_NOTIFIER_RETRY_BASE_MS=1000
ALERT_NOTIFIER_RETRY_MAX_MS=60000
# HTTPS is required. minimumSeverity=warning includes critical alerts too.
# Each target is tenant-scoped and receives HMAC-signed JSON.
ALERT_NOTIFIER_TARGETS=[{"id":"oncall-critical","tenantId":"replace-with-tenant-uuid","webhookUrl":"https://replace-with-approved-alert-webhook.example.com/events","signingSecret":"replace-with-distinct-signing-secret-at-least-32-chars","minimumSeverity":"critical"}]
