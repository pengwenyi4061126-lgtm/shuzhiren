# Control plane. Set real values only in the target deployment environment.
NODE_ENV=development
DATABASE_URL=postgresql://shuzhiren:replace-me@localhost:5432/shuzhiren
CONTROL_PLANE_DEMO_MODE=true

# Authentication is mandatory in production. These are issuer/audience identifiers,
# not secrets; secrets belong in the deployment secret manager.
OIDC_ISSUER_URL=https://replace-with-issuer
OIDC_AUDIENCE=shuzhiren-control-plane
OIDC_JWKS_URL=https://replace-with-issuer/.well-known/jwks.json

# Runtime outbox worker. This database identity is deployment-only and must not be exposed to browsers.
OUTBOX_POLL_MS=1000
SCHEDULER_POLL_MS=1000
SCHEDULER_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=6

# Runtime-to-control-plane service authentication. Set this in the deployment secret
# manager and inject it into the GPU gateway/worker. Development defaults to a demo token.
RUNTIME_TELEMETRY_TOKEN=replace-with-a-long-random-secret
