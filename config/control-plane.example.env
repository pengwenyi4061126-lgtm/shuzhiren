# Control plane. Set real values only in the target deployment environment.
NODE_ENV=development
DATABASE_URL=postgresql://shuzhiren:replace-me@localhost:5432/shuzhiren
# Bounds control-plane connection and query waits, including Docker readiness checks.
DATABASE_QUERY_TIMEOUT_MS=5000
CONTROL_PLANE_DEMO_MODE=true
# Immutable source revision deployed into this control-plane instance. Required
# in production and exposed by the unauthenticated readiness endpoint.
RELEASE_REVISION=replace-with-40-character-git-commit

# Authentication is mandatory in production. These are issuer/audience identifiers,
# not secrets; secrets belong in the deployment secret manager.
OIDC_ISSUER_URL=https://replace-with-issuer
OIDC_AUDIENCE=shuzhiren-control-plane
OIDC_JWKS_URL=https://replace-with-issuer/.well-known/jwks.json
# Browser clients may keep the OIDC access token in this same-site, HttpOnly cookie.
OIDC_ACCESS_TOKEN_COOKIE=shuzhiren_access_token
# Comma-separated browser origins allowed to issue state-changing cookie-authenticated API calls.
# Leave empty only when the reverse proxy forwards the public Host correctly.
OIDC_ALLOWED_ORIGINS=https://console.replace-with-domain

# Runtime outbox worker. This database identity is deployment-only and must not be exposed to browsers.
OUTBOX_POLL_MS=1000
SCHEDULER_POLL_MS=1000
SCHEDULER_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=6
# Private Gateway access for runtime-session verification and operator commands.
# This is a backend-only credential shared with runtime.env and gateway.env; it
# must never be exposed to browser code, channel adapters, or tenant ingestion.
RUNTIME_GATEWAY_URL=http://runtime-gateway:8090
RUNTIME_SHARED_TOKEN=replace-with-a-long-random-token
RUNTIME_GATEWAY_DEMO_MODE=false
# Must match runtime.env. Bounds every control-plane request to the private Gateway.
RUNTIME_GATEWAY_REQUEST_TIMEOUT_MS=20000

# Runtime-to-control-plane service authentication. Each JSON map contains one
# distinct secret per tenant; a service credential cannot submit another tenant's
# events. Keep both maps in the deployment secret manager, never in browsers.
RUNTIME_TELEMETRY_TENANT_TOKENS={"replace-with-tenant-uuid":"replace-with-runtime-secret-at-least-32-chars"}
# Separate credential used only after a recording has been copied to approved object storage and SHA-256 verified.
RUNTIME_RECORDING_TENANT_TOKENS={"replace-with-tenant-uuid":"replace-with-recording-secret-at-least-32-chars"}
# Dedicated PIM/ERP server credential. Facts always enter as a draft version for reviewer approval.
PIM_INGEST_TENANT_TOKENS={"replace-with-tenant-uuid":"replace-with-pim-secret-at-least-32-chars"}
CHANNEL_INGEST_TENANT_TOKENS={"replace-with-tenant-uuid":"replace-with-channel-secret-at-least-32-chars"}
# A distinct private credential for normalized impressions, carts, payments and refunds.
CHANNEL_COMMERCE_TENANT_TOKENS={"replace-with-tenant-uuid":"replace-with-commerce-secret-at-least-32-chars"}
