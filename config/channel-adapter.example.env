# Private normalized channel-webhook bridge. Never expose this service directly
# to browsers; terminate the platform webhook at an authenticated reverse proxy.
DATABASE_URL=postgresql://shuzhiren:replace-me@postgres:5432/shuzhiren
# Connection acquisition and individual query deadline for durable replay protection.
DATABASE_QUERY_TIMEOUT_MS=5000
CONTROL_PLANE_URL=https://replace-with-private-control-plane.example.com
CHANNEL_ADAPTER_PORT=8082
CHANNEL_ADAPTER_REPLAY_LEASE_SECONDS=60
CHANNEL_ADAPTER_MAX_REQUESTS_PER_MINUTE=120
# Private worker-to-adapter credential. It is unrelated to all platform/webhook secrets.
CHANNEL_ADAPTER_DISPATCH_TOKEN=replace-with-another-long-random-token
# Each target has independent HMAC, ingest, and provider-reply credentials. The provider endpoint
# must accept the normalized request and return {"providerMessageId":"..."}; platform OAuth and
# account/app approval remain external deployment prerequisites.
CHANNEL_ADAPTER_TARGETS=[{"tenantId":"replace-with-tenant-uuid","channelConnectionId":"replace-with-channel-uuid","signingSecret":"replace-with-signing-secret-at-least-32-chars","interactionToken":"replace-with-interaction-secret-at-least-32-chars","commerceToken":"replace-with-commerce-secret-at-least-32-chars","providerReplyEndpoint":"https://replace-with-private-provider-bridge.example.com/v1/replies","providerReplyToken":"replace-with-provider-reply-secret-at-least-32-chars"}]
