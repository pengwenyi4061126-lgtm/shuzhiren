# Private normalized channel-webhook bridge. Never expose this service directly
# to browsers; terminate the platform webhook at an authenticated reverse proxy.
DATABASE_URL=postgresql://shuzhiren:replace-me@postgres:5432/shuzhiren
CONTROL_PLANE_URL=https://replace-with-private-control-plane.example.com
CHANNEL_ADAPTER_PORT=8082
CHANNEL_ADAPTER_REPLAY_LEASE_SECONDS=60
CHANNEL_ADAPTER_MAX_REQUESTS_PER_MINUTE=120
# Each target has independent HMAC, comment-ingest and commerce-ingest secrets.
CHANNEL_ADAPTER_TARGETS=[{"tenantId":"replace-with-tenant-uuid","channelConnectionId":"replace-with-channel-uuid","signingSecret":"replace-with-signing-secret-at-least-16-chars","interactionToken":"replace-with-interaction-secret-at-least-16-chars","commerceToken":"replace-with-commerce-secret-at-least-16-chars"}]
