# Schema Migrator connection for the one-shot control-plane-migrate Compose profile
# (MIGRATION_OWNER_ENV_FILE in control-plane-compose.env points here). Keep the
# real file outside Git, readable only by the deployment operator.
#
# D4 (2026-11-05): migrations run as the dedicated migration owner
# shuzhiren_migration_owner (LOGIN, BYPASSRLS, no SUPERUSER, CREATEDB, CREATEROLE
# or REPLICATION). It owns every table, sequence, type and function the
# migrations create; application and service accounts own nothing and never
# use this connection string. The same account runs service-principals.sql,
# backup-principal.sql and control-plane-principal.sql after each migration.
# The control-plane service does not load this file, and this file must not
# define DATABASE_URL.
MIGRATION_OWNER_DATABASE_URL=postgresql://shuzhiren_migration_owner:replace-me@localhost:5432/shuzhiren
# Transaction-local lock_timeout and statement_timeout for each migration, in
# milliseconds (integer 1 to 86400000). Defaults: 10000 and 1800000. A migration
# file may override them with SET LOCAL.
# MIGRATION_LOCK_TIMEOUT_MS=10000
# MIGRATION_STATEMENT_TIMEOUT_MS=1800000
