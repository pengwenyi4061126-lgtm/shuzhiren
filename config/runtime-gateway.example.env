NVIDIA_VISIBLE_DEVICES=0
# Generate at least 32 random non-whitespace characters; it must match the
# runtime env value but no other service credential.
RUNTIME_SHARED_TOKEN=replace-with-a-long-random-token
# Runtime Gateway synthesizes every program script and speech command with
# CosyVoice and injects the audio into LiveTalking (which runs with --tts none).
# Start the cosyvoice Compose profile and keep this true; production preflight
# runs deploy:check with --require-cosyvoice.
COSYVOICE_REQUIRED=true
# sft: /inference_sft with spk_id = the approved runtime_voice_id (the model must
# ship that speaker). zero_shot: /inference_zero_shot with the approved reference
# audio. The locked Fun-CosyVoice3 model has no built-in SFT speakers: use zero_shot.
COSYVOICE_MODEL_KIND=zero_shot
# sft only, optional: JSON object mapping runtime_voice_id to the model's spk_id, e.g.
# {"preset-zh-female":"中文女"}. Empty uses the built-in map of the default presets
# (preset-zh-female -> 中文女, preset-zh-male -> 中文男); the Gateway refuses to start with an
# invalid value, in both model kinds.
COSYVOICE_SFT_SPEAKER_MAP=
# Host directory mounted read-only at /run/shuzhiren/voices. One directory per
# runtime_voice_id holding prompt.wav (the approved voice asset, byte-identical to
# its checksum) and prompt.txt (UTF-8; for Fun-CosyVoice3:
# "You are a helpful assistant.<|endofprompt|>" followed by the exact transcript).
COSYVOICE_VOICE_LIBRARY_PATH=/srv/shuzhiren/voices
# Longer scripts are split at sentence ends into requests of at most this many characters (20-800).
COSYVOICE_CHUNK_MAX_CHARS=120
# Upstream time budget for one command (1-59 s), counted from its reservation;
# synthesis stops min(3 s, 25%) earlier to leave time for LiveTalking. Keep it
# below RUNTIME_GATEWAY_REQUEST_TIMEOUT_MS in runtime.example.env.
RUNTIME_COMMAND_DEADLINE_SECONDS=15
# The locked Fun-CosyVoice3 model emits raw 16-bit mono PCM at 24 kHz. Set this
# to the selected model's documented output rate before enabling the profile.
COSYVOICE_SAMPLE_RATE=24000
# Completed command cache retention. Production Compose also persists command identities
# on a dedicated Gateway volume so a restart cannot replay completed media actions.
MEDIA_COMMAND_CACHE_TTL_SECONDS=3600
MEDIA_COMMAND_CACHE_MAX_ENTRIES=2048
# Deadline in seconds for each Gateway call to LiveTalking or CosyVoice.
RUNTIME_REQUEST_TIMEOUT_SECONDS=15
# Direct Gateway launches must use an encrypted, private writable path and require it.
RUNTIME_COMMAND_JOURNAL_PATH=/var/lib/shuzhiren-runtime/commands.sqlite3
RUNTIME_COMMAND_JOURNAL_REQUIRED=true
# Host path mounted at /var/lib/shuzhiren-runtime by Compose. Gateway runs as
# UID 10001. For scheduled snapshots, make this a setgid 2750 directory owned by
# 10001:shuzhiren-backup so private journal files remain readable by that backup group.
# Include it in host backup and restore evidence; never use an anonymous container filesystem.
RUNTIME_GATEWAY_STATE_PATH=/srv/shuzhiren/runtime-gateway-state
# Host interface for the token-protected Gateway port. Keep loopback for a
# same-host console; cross-host control must use an explicitly approved private IP.
RUNTIME_GATEWAY_HOST_BIND=127.0.0.1
# Optional controlled operator preview. The broker must issue a new short-lived
# HTTPS WebRTC embed grant for each authenticated Gateway request; never put a
# static preview URL, RTMP ingest URL, or browser credential in this file.
PREVIEW_BROKER_URL=
PREVIEW_BROKER_TOKEN=
PREVIEW_GRANT_MAX_SECONDS=600
LIVETALKING_AVATAR_ID=approved_avatar_001
# Action slots configured in the approved LiveTalking avatar package.
PROGRAM_AUDIOTYPE=0
FALLBACK_AUDIOTYPE=1
HUMAN_HANDOFF_AUDIOTYPE=2
MODEL_VOLUME_PATH=/srv/shuzhiren/models
AVATAR_VOLUME_PATH=/srv/shuzhiren/avatars
# Host path on an encrypted, backed-up disk. LiveTalking writes here as UID/GID
# 10002, so prepare it for 10002:10002; do not use an anonymous Docker volume.
RECORDINGS_VOLUME_PATH=/srv/shuzhiren/recordings
COSYVOICE_MODEL_PATH=/srv/shuzhiren/cosyvoice-models
# Absolute container path. Compose mounts COSYVOICE_MODEL_PATH at
# /opt/CosyVoice/CosyVoice/pretrained_models.
COSYVOICE_MODEL_DIR=/opt/CosyVoice/CosyVoice/pretrained_models/Fun-CosyVoice3-0.5B-2512
# Must equal STREAM_RTMP_URL in runtime.example.env. The stream key is not set
# here: it lives only in the file named by STREAM_KEY_FILE.
STREAM_RTMP_URL=rtmp://replace-with-platform-ingest/live
