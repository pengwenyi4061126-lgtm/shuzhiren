# Required host and stream settings. Do not commit real secrets.
NVIDIA_VISIBLE_DEVICES=0
# Deployment capability gate: this locked runtime only implements RTMP output.
STREAM_OUTPUT_MODE=rtmp
STREAM_RTMP_URL=rtmp://replace-with-platform-ingest/live
STREAM_KEY=replace-with-secret-key
# LiveTalking's MuseTalk path requires 25fps. Avatar source resolution is defined by
# the approved avatar media, not by a runtime CLI flag.
STREAM_FPS=25

# Start in safe mode: pre-rendered media remains the fallback.
LIVE_MAX_CONCURRENT_AVATARS=1
LIVE_ALLOW_LLM_FREEFORM=false
LIVE_REQUIRE_HUMAN_HANDOFF_FOR_HIGH_RISK=true
LIVE_REQUIRE_AI_DISCLOSURE=true

# Externalize the LLM in a one-GPU deployment.
LLM_MODE=external
LLM_BASE_URL=https://replace-with-controlled-llm-endpoint
LLM_MODEL=replace-with-approved-model

# Pin these after P0 validation. Never use floating production tags.
LIVETALKING_REF=replace-with-commit-sha
MUSETALK_REF=replace-with-commit-sha
COSYVOICE_REF=replace-with-commit-sha

# Runtime Gateway isolates the control plane from vendor APIs. Disable demo mode on the 4090 host.
RUNTIME_GATEWAY_URL=http://runtime-gateway:8090
# Generate at least 32 random non-whitespace characters; never reuse it for a
# tenant ingestion, alert, browser, or output-probe credential.
RUNTIME_SHARED_TOKEN=replace-with-a-long-random-token
RUNTIME_GATEWAY_DEMO_MODE=false
# Hard upper bound for a single media or speech command delivery. Timeouts are
# retried through the durable outbox rather than allowing a worker tick to hang.
RUNTIME_GATEWAY_REQUEST_TIMEOUT_MS=20000
# Channel replies are sent to the private adapter, never to Runtime Gateway.
CHANNEL_ADAPTER_URL=http://channel-adapter:8082
# Generate a separate 32+ character service credential and match it in
# channel-adapter.example.env. It is not a platform OAuth credential.
CHANNEL_ADAPTER_DISPATCH_TOKEN=replace-with-another-long-random-token
# The worker, channel adapter, and alert notifier share the production control-plane database.
# Use a private host and a dedicated least-privilege deployment account.
DATABASE_URL=postgresql://shuzhiren:replace-with-password@replace-with-private-postgres:5432/shuzhiren
# Connection acquisition and individual query deadline for runtime-worker.
DATABASE_QUERY_TIMEOUT_MS=5000
CONTROL_PLANE_URL=https://replace-with-private-control-plane.example.com
# Compose loads this file from RUNTIME_OBSERVER_TARGETS_DIR/runtime-observer-targets.json
# and hot-reloads it without restarting the runtime. The directory must be private,
# read-only in the container, and updated atomically by deployment automation.
RUNTIME_OBSERVER_TARGETS_DIR=/srv/shuzhiren/observer-config
# Used only for direct non-Compose launches and local tests. Each JSON target binds
# tenantId/runId/sessionId/telemetryToken/outputProbeUrl and optional outputProbeToken.
RUNTIME_OBSERVER_TARGETS=[]
RUNTIME_OBSERVER_POLL_MS=5000
RUNTIME_OBSERVER_TIMEOUT_MS=3000
RUNTIME_OBSERVER_FAIL_CLOSED=true
RUNTIME_OBSERVER_PORT=8084
# Optional local destination-probe service. Each target may require expectedFps and an
# expectedWidth/expectedHeight pair; mismatched received output fails closed.
# Generate at least 32 random non-whitespace characters, distinct from every
# other service token.
OUTPUT_PROBE_SHARED_TOKEN=replace-with-a-different-long-random-token
OUTPUT_PROBE_TARGETS=[]
OUTPUT_PROBE_TIMEOUT_MS=5000
OUTPUT_PROBE_CACHE_MS=3000
OUTPUT_PROBE_AUDIO_SAMPLE_SECONDS=5
OUTPUT_PROBE_SILENCE_DURATION_SECONDS=2
OUTPUT_PROBE_SILENCE_THRESHOLD_DB=-50
# A LIVE run whose last observer sample is older than this is degraded once; recovery stays manual.
RUNTIME_WATCHDOG_POLL_MS=5000
RUNTIME_WATCHDOG_BATCH_SIZE=10
RUNTIME_TELEMETRY_MAX_AGE_SECONDS=60
# Records one idempotent live-minute bucket per LIVE run. Entitlements only
# enforce limits after an administrator configures them in the control plane.
USAGE_METER_POLL_MS=60000
PROGRAM_AUDIOTYPE=0
FALLBACK_AUDIOTYPE=1
HUMAN_HANDOFF_AUDIOTYPE=2
OUTBOX_MAX_ATTEMPTS=6
OUTBOX_LEASE_SECONDS=60
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=60000
RUNTIME_WORKER_PORT=8080
