# Required host and stream settings. Do not commit real secrets.
NVIDIA_VISIBLE_DEVICES=0
# Production Compose only pulls reviewed images by manifest digest. Do not use a
# tag (including latest), a local build, or an image ID as a release reference.
RUNTIME_GATEWAY_IMAGE=replace-with-registry.example.com/shuzhiren/runtime-gateway@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
RUNTIME_WORKER_IMAGE=replace-with-registry.example.com/shuzhiren/runtime-worker@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
RUNTIME_OBSERVER_IMAGE=replace-with-registry.example.com/shuzhiren/runtime-observer@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
OUTPUT_PROBE_IMAGE=replace-with-registry.example.com/shuzhiren/output-probe@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
CHANNEL_ADAPTER_IMAGE=replace-with-registry.example.com/shuzhiren/channel-adapter@sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
ALERT_NOTIFIER_IMAGE=replace-with-registry.example.com/shuzhiren/alert-notifier@sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
LIVETALKING_IMAGE=replace-with-registry.example.com/shuzhiren/livetalking@sha256:1111111111111111111111111111111111111111111111111111111111111111
COSYVOICE_IMAGE=replace-with-registry.example.com/shuzhiren/cosyvoice@sha256:2222222222222222222222222222222222222222222222222222222222222222
# Deployment capability gate: this locked runtime only implements RTMP output.
STREAM_OUTPUT_MODE=rtmp
# Ingest base address without the stream key (rtmp:// or rtmps://, no trailing
# slash, no credentials, query or fragment). LiveTalking pushes to
# ${STREAM_RTMP_URL}/<key from STREAM_KEY_FILE>.
STREAM_RTMP_URL=rtmp://replace-with-platform-ingest/live
# Host path of a file that contains only the stream key (one line, printable
# ASCII without spaces, quotes or backslashes, at most 1024 bytes). Compose
# mounts it read-only at /run/secrets/stream-key. Both the LiveTalking container
# (UID/GID 10002) and the account that runs npm run deploy:check must read it,
# and deploy:check rejects a key file that group or other users can write or
# that other users can read. Own it by the deploy:check account with group
# 10002 and mode 0440, for example:
#   sudo install -d -m 0700 -o "$USER" /srv/shuzhiren/secrets
#   (umask 077; read -rs key; printf '%s\n' "$key" > /srv/shuzhiren/secrets/stream-key)
#   sudo chown "$USER:10002" /srv/shuzhiren/secrets/stream-key
#   chmod 0440 /srv/shuzhiren/secrets/stream-key
# Never put the key itself in an env file.
STREAM_KEY_FILE=/srv/shuzhiren/secrets/stream-key
# LiveTalking's MuseTalk path requires 25fps. Avatar source resolution is defined by
# the approved avatar media, not by a runtime CLI flag.
STREAM_FPS=25

# Start in safe mode: pre-rendered media remains the fallback.
LIVE_MAX_CONCURRENT_AVATARS=1
LIVE_ALLOW_LLM_FREEFORM=false
LIVE_REQUIRE_HUMAN_HANDOFF_FOR_HIGH_RISK=true
LIVE_REQUIRE_AI_DISCLOSURE=true

# AIGC explicit label (人工智能生成合成内容标识办法, 2025-09-01). LiveTalking draws it on
# every pushed and recorded frame and it cannot be turned off: AIGC_LABEL_ENABLED must be
# true or the LiveTalking launcher exits 78 and deploy:check fails. AIGC_LABEL_TEXT must
# contain "AI" or "人工智能", at most 32 characters, and equal the control plane's
# AIGC_LABEL_TEXT. AIGC_LABEL_POSITION: top-left, top-right, bottom-left or bottom-right.
AIGC_LABEL_ENABLED=true
AIGC_LABEL_TEXT=本直播由AI数字人生成
AIGC_LABEL_POSITION=top-right

# Externalize the LLM in a one-GPU deployment.
LLM_MODE=external
LLM_BASE_URL=https://replace-with-controlled-llm-endpoint
LLM_MODEL=replace-with-approved-model


# Runtime Gateway isolates the control plane from vendor APIs. Disable demo mode on the 4090 host.
RUNTIME_GATEWAY_URL=http://runtime-gateway:8090
# Generate at least 32 random non-whitespace characters; never reuse it for a
# tenant ingestion, alert, browser, or output-probe credential.
RUNTIME_SHARED_TOKEN=replace-with-a-long-random-token
# Read-only Gateway credential, given only to runtime-gateway and runtime-observer.
# It can read GET /v1/observations/{session_id} and nothing else (403 elsewhere).
# Generate at least 32 random non-whitespace characters, different from
# RUNTIME_SHARED_TOKEN, PREVIEW_BROKER_TOKEN and every other service token.
RUNTIME_GATEWAY_READ_TOKEN=replace-with-a-separate-read-only-random-token
RUNTIME_GATEWAY_DEMO_MODE=false
# Hard upper bound for a single media or speech command delivery. Timeouts are
# retried through the durable outbox rather than allowing a worker tick to hang.
RUNTIME_GATEWAY_REQUEST_TIMEOUT_MS=20000
# Channel replies are sent to the private adapter, never to Runtime Gateway.
CHANNEL_ADAPTER_URL=http://channel-adapter:8082
# Generate a separate 32+ character service credential and match it in
# channel-adapter.example.env. It is not a platform OAuth credential.
CHANNEL_ADAPTER_DISPATCH_TOKEN=replace-with-another-long-random-token
# Runtime worker database identity. It must be the dedicated
# shuzhiren_runtime_worker account provisioned by service-principals.sql.
RUNTIME_WORKER_DATABASE_URL=postgresql://shuzhiren_runtime_worker:replace-with-password@replace-with-private-postgres:5432/shuzhiren
# Connection acquisition and individual query deadline for runtime-worker.
DATABASE_QUERY_TIMEOUT_MS=5000
CONTROL_PLANE_URL=https://replace-with-private-control-plane.example.com
# Compose loads this file from RUNTIME_OBSERVER_TARGETS_DIR/runtime-observer-targets.json
# and hot-reloads it without restarting the runtime. The directory must be private,
# read-only in the container, and updated atomically by deployment automation.
RUNTIME_OBSERVER_TARGETS_DIR=/srv/shuzhiren/observer-config
# Used only for direct non-Compose launches and local tests. Each JSON target binds
# tenantId/runId/sessionId/telemetryToken/programOutputToken/outputProbeUrl and optional outputProbeToken.
# When the output-probe target also has programEvidenceUrl, it may return a
# signed command/segment/content-hash observation. programOutputToken must match
# the control plane's separate PROGRAM_OUTPUT_OBSERVATION_TENANT_TOKENS map; it
# never reuses telemetryToken. The verifier URL and optional programEvidenceToken
# belong only in the private probe target config.
RUNTIME_OBSERVER_TARGETS=[]
RUNTIME_OBSERVER_POLL_MS=5000
RUNTIME_OBSERVER_TIMEOUT_MS=3000
RUNTIME_OBSERVER_FAIL_CLOSED=true
RUNTIME_OBSERVER_PORT=8084
# Optional local destination-probe service. Each target may require expectedFps and an
# expectedWidth/expectedHeight pair; mismatched received output fails closed.
# Generate at least 32 random non-whitespace characters, distinct from every
# other service token.
OUTPUT_PROBE_SHARED_TOKEN=replace-with-a-different-long-random-token
OUTPUT_PROBE_TARGETS=[]
OUTPUT_PROBE_TIMEOUT_MS=5000
OUTPUT_PROBE_CACHE_MS=3000
OUTPUT_PROBE_AUDIO_SAMPLE_SECONDS=5
OUTPUT_PROBE_SILENCE_DURATION_SECONDS=2
OUTPUT_PROBE_SILENCE_THRESHOLD_DB=-50
# A LIVE run whose last observer sample is older than this is degraded once; recovery stays manual.
RUNTIME_WATCHDOG_POLL_MS=5000
RUNTIME_WATCHDOG_BATCH_SIZE=10
RUNTIME_TELEMETRY_MAX_AGE_SECONDS=60
# Records one idempotent live-minute bucket per LIVE run. Entitlements only
# enforce limits after an administrator configures them in the control plane.
USAGE_METER_POLL_MS=60000
PROGRAM_AUDIOTYPE=0
FALLBACK_AUDIOTYPE=1
HUMAN_HANDOFF_AUDIOTYPE=2
# Runtime Compose passes every worker tuning value below from this file; keep
# OUTBOX_MAX_ATTEMPTS equal to the control-plane value.
OUTBOX_POLL_MS=1000
SCHEDULER_POLL_MS=1000
SCHEDULER_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=6
OUTBOX_LEASE_SECONDS=60
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=60000
RUNTIME_WORKER_PORT=8080
