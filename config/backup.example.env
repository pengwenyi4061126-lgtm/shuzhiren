# Private environment for the non-root scheduled backup account. Do not commit
# production credentials. DATABASE_URL uses only the dedicated PostgreSQL
# shuzhiren_backup LOGIN NOINHERIT BYPASSRLS principal provisioned through
# infra/postgres/backup-principal.sql; it must never be reused by an app,
# console, adapter, or human interactive shell. The scripts fall back to local
# development Compose only when DATABASE_URL is intentionally omitted.
DATABASE_URL=postgresql://shuzhiren_backup:replace-with-password@replace-with-private-postgres:5432/shuzhiren
POSTGRES_BACKUP_DIR=/srv/shuzhiren/backups/postgres
GATEWAY_BACKUP_DIR=/srv/shuzhiren/backups/runtime-gateway
RUNTIME_GATEWAY_STATE_PATH=/srv/shuzhiren/runtime-gateway-state
PYTHON_BIN=/usr/bin/python3
