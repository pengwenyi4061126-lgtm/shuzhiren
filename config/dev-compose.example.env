# Credentials for the development-only infra/compose/docker-compose.yml.
# Copy this file to infra/compose/.env (ignored by Git) and replace every value
# with a locally generated random string. Never reuse these values elsewhere.
DEV_POSTGRES_PASSWORD=replace-with-a-local-random-password
DEV_REDIS_PASSWORD=replace-with-another-local-random-password
DEV_MINIO_ROOT_USER=replace-with-a-local-minio-user
DEV_MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password-of-8-or-more-characters
