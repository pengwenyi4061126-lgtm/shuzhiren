# Credentials for the development-only infra/compose/docker-compose.yml.
# Copy this file to infra/compose/.env (ignored by Git) and replace each
# credential placeholder with a locally generated unique value; keep URLs unchanged.
# Never reuse the development credentials elsewhere.
DEV_POSTGRES_PASSWORD=replace-with-a-local-random-password
DEV_REDIS_PASSWORD=replace-with-another-local-random-password
DEV_MINIO_ROOT_USER=replace-with-a-local-minio-user
DEV_MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password-of-8-or-more-characters
MEDIA_EVIDENCE_VERIFIER_URL=http://127.0.0.1:8089
MEDIA_EVIDENCE_VERIFIER_TOKEN=replace-with-a-local-random-token-of-at-least-48-characters
MEDIA_UPLOAD_ALLOWED_ORIGINS=http://127.0.0.1:9000
