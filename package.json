{
  "name": "shuzhiren",
  "version": "0.1.0",
  "private": true,
  "description": "Commercial digital-human live operations platform",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @shuzhiren/console",
    "build": "npm run build --workspace @shuzhiren/console",
    "lint": "npm run lint --workspace @shuzhiren/console",
    "typecheck": "npm run typecheck --workspace @shuzhiren/console",
    "db:migrate": "npm run db:migrate --workspace @shuzhiren/console",
    "db:verify": "node scripts/verify-postgres-schema.mjs",
    "worker:runtime": "npm run start --workspace @shuzhiren/runtime-worker",
    "observer:runtime": "npm run start --workspace @shuzhiren/runtime-observer",
    "observer:runtime:test": "node scripts/test-runtime-observer.mjs",
    "output-probe:test": "node scripts/test-output-probe.mjs",
    "deploy:check": "node scripts/check-deployment-config.mjs",
    "policy:red-team": "node scripts/check-policy-redteam.mjs",
    "preflight:check": "node scripts/check-preflight-runtime-readiness.mjs",
    "start:ack:check": "node scripts/check-start-ack-gate.mjs",
    "runtime:watchdog:check": "node scripts/check-runtime-watchdog.mjs",
    "control-plane:integration": "node scripts/test-control-plane-postgres.mjs"
  },
  "devDependencies": {
    "jose": "6.2.1",
    "pg": "8.23.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
