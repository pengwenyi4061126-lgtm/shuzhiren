# Exclude everything, then allow only the locked CosyVoice source. Docker applies
# the last matching rule, so the forbidden categories below the allow list also
# apply inside vendor/CosyVoice (including its third_party submodule).
*
vendor/*
!vendor/CosyVoice/**
**/.git
**/.git/**
vendor/CosyVoice/.git
vendor/CosyVoice/.git/**
**/.env
**/.env.*
!**/.env.example
**/secrets
**/secrets/**
**/weights
**/weights/**
**/recordings
**/recordings/**
**/exports
**/exports/**
**/cache
**/cache/**
**/logs
**/logs/**
**/*.log
# Model weights are mounted read-only at deploy time.
vendor/CosyVoice/pretrained_models
vendor/CosyVoice/pretrained_models/**
