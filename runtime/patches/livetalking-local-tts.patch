+# Modified by the Shuzhiren project; see /app/LIVETALKING_MODIFICATIONS.md
+# Added by the Shuzhiren project: this file is new and is not part of upstream LiveTalking.
+from utils.logger import logger
+from registry import register
+from .base_tts import BaseTTS
+
+
+@register("tts", "none")
+class DisabledTTS(BaseTTS):
+    """No speech synthesis. Shuzhiren sends CosyVoice audio through /humanaudio.
+
+    The object exists only because BaseAvatar.render() starts self.tts; text sent
+    to /human is dropped here and never reaches an online TTS service.
+    """
+
+    def put_msg_txt(self, msg: str, datainfo: dict = {}):
+        logger.warning("tts disabled; dropped %d characters", len(msg))
+
+    def txt_to_audio(self, msg: tuple[str, dict]):
+        pass
