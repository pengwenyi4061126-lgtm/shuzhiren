+async def admin_overlay(request):
+    """Admin: picture layer state of this process (scene hash, frame counters, layer conflicts, last error)."""
+    try:
+        return json_ok(data=shuzhiren_overlay.status())
+    except Exception as e:
+        logger.exception('admin_overlay exception:')
+        return json_error(str(e))
+
+async def admin_overlay_scene(request):
+    """Admin: install the frozen scene of a session. A scene that fails validation is refused whole and the
+    scene in force stays unchanged; on success the scene hash is echoed back."""
+    try:
+        params = await request.json()
+        sessionid = params.get('sessionid', '')
+        avatar_session = get_session(request, sessionid)
+        if avatar_session is None:
+            return json_error("session not found")
+        overlay = getattr(avatar_session, 'overlay', None)
+        if overlay is None:
+            return json_error("overlay not available")
+        try:
+            scene = overlay.set_scene(params.get('scene_json'), params.get('scene_sha256'))
+        except shuzhiren_overlay.OverlayError as e:
+            return json_error(f"overlay scene rejected: {e.reason}")
+        return json_ok(data={"scene_sha256": scene.sha256})
+    except Exception as e:
+        logger.exception('admin_overlay_scene exception:')
+        return json_error(str(e))
+
 
