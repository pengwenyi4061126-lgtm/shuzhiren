         return json_error(str(e))
 
+async def admin_runtime_metrics(request):
+    """Admin: provide measured in-process metrics without exposing stream secrets."""
+    try:
+        sessions_info = []
+        for sid, avatar_session in session_manager.sessions.items():
+            if avatar_session:
+                sessions_info.append({
+                    "sessionid": sid,
+                    "speaking": avatar_session.is_speaking() if hasattr(avatar_session, 'is_speaking') else False,
+                    "recording": getattr(avatar_session, 'recording', False),
+                    "metrics": getattr(avatar_session, 'runtime_metrics', {}),
+                })
+        return json_ok(data={"sessions": sessions_info})
+    except Exception as e:
+        logger.exception('admin_runtime_metrics exception:')
+        return json_error(str(e))
+
 
