+async def admin_stream_start(request):
+    try:
+        params = await request.json()
+        sessionid = params.get('sessionid', '')
+        avatar_session = get_session(request, sessionid)
+        output = getattr(avatar_session, 'output', None)
+        if output is None or not hasattr(output, 'start_stream'):
+            return json_error("stream output is unavailable")
+        output.start_stream()
+        return json_ok(data={"sessionid": sessionid, "streaming": True})
+    except Exception as e:
+        logger.exception('admin_stream_start exception:')
+        return json_error(str(e))
+
+async def admin_stream_stop(request):
+    try:
+        params = await request.json()
+        sessionid = params.get('sessionid', '')
+        avatar_session = get_session(request, sessionid)
+        output = getattr(avatar_session, 'output', None)
+        if output is None or not hasattr(output, 'stop_stream'):
+            return json_error("stream output is unavailable")
+        output.stop_stream()
+        return json_ok(data={"sessionid": sessionid, "streaming": False})
+    except Exception as e:
+        logger.exception('admin_stream_stop exception:')
+        return json_error(str(e))
+
 
